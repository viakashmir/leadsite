// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Content / SEO side ----------

enum DestinationKind {
  STATE
  UNION_TERRITORY
  COUNTRY
  REGION
  CIRCUIT
}

enum ContentStatus {
  DRAFT // structure only: page renders but is noindex
  READY // content reviewed: indexable
}

// Top-level travel destination, TravelTriangle-style: the name people search
// ("kashmir", "himachal", "thailand"), plus multi-stop circuits.
// Structure comes from src/data/locations.ts via prisma/seed-locations.ts.
model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  officialName String?
  kind        DestinationKind @default(STATE)
  zone        String?
  state       String?
  country     String   @default("India")
  isInternational Boolean @default(false)
  premium     Boolean  @default(false)
  tier        Int      @default(3)
  sortOrder   Int      @default(0)
  leadUnlockPrice Int? // overrides the default per-lead price for this destination
  summary     String   @default("")
  heroImage   String   @default("")
  content     Json?    // guide sections: intro, bestTime, howToReach, tips, faqs...
  seoTitle    String?
  seoDescription String?
  contentStatus ContentStatus @default(DRAFT)
  legacySlugs String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cities      City[]
  places      Place[]
  packages    Package[]
  leads       Lead[]
  agentLinks  AgentDestination[]
  circuitStops CircuitStop[] @relation("CircuitStops")
  stopOf      CircuitStop[] @relation("StopDestination")

  @@index([kind])
  @@index([zone])
}

model City {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  kind          String?  // hill-station, beach, pilgrimage...
  tier          Int      @default(3)
  sortOrder     Int      @default(0)
  summary       String   @default("")
  heroImage     String   @default("")
  content       Json?
  seoTitle      String?
  seoDescription String?
  contentStatus ContentStatus @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  lat           Float?
  lng           Float?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  places        Place[]
  packages      Package[]
  leads         Lead[]
  stopOf        CircuitStop[]

  @@index([destinationId])
}

enum PlaceKind {
  PLACE    // places to visit
  ACTIVITY // things to do
}

// Attraction or activity. `path` is the URL tail under /{destination}-tourism,
// e.g. "srinagar/places-to-visit/dal-lake" or "places-to-visit/red-fort".
model Place {
  id            String   @id @default(cuid())
  path          String   @unique
  slug          String
  name          String
  kind          PlaceKind @default(PLACE)
  sortOrder     Int      @default(0)
  summary       String   @default("")
  heroImage     String   @default("")
  content       Json?
  contentStatus ContentStatus @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])

  @@index([destinationId])
  @@index([cityId])
}

// Ordered stop of a circuit (a Destination with kind CIRCUIT). A stop points
// at either a destination (e.g. "sikkim") or a city (e.g. "gangtok").
model CircuitStop {
  id            String   @id @default(cuid())
  circuitId     String
  circuit       Destination @relation("CircuitStops", fields: [circuitId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation("StopDestination", fields: [destinationId], references: [id])
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])
  sortOrder     Int      @default(0)

  @@index([circuitId])
}

model Package {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String
  itinerary     String   // markdown/plain text
  heroImage     String
  durationDays  Int
  durationNights Int
  price         Int      // starting price in INR
  theme         String   // comma-separated tags e.g. "Honeymoon,Family"
  published     Boolean  @default(true)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])

  agentId       String?  // null = platform/curated package, set = agent-submitted (UGC)
  agent         Agent?   @relation(fields: [agentId], references: [id])

  leads         Lead[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([destinationId])
  @@index([cityId])
  @@index([agentId])
}

// ---------- Lead capture / marketplace side ----------

enum LeadStatus {
  NEW
  VERIFIED
  BOOKED
  STALE
}

model Lead {
  id            String   @id @default(cuid())

  name          String
  email         String?
  phone         String
  originCity    String?  // where the traveler is traveling from

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])
  sourcePackageId String?
  sourcePackage Package? @relation(fields: [sourcePackageId], references: [id])

  travelDate    DateTime?
  durationDays  Int?
  adults        Int      @default(2)
  children      Int      @default(0)
  budgetBand    String?  // e.g. "Economy (0-2 Star)", "Rs. 25000 - Rs. 50000"
  message       String?

  status        LeadStatus @default(NEW)
  verified      Boolean  @default(false)
  otpVerifiedAt DateTime?

  unlockPrice   Int      @default(100) // credits/INR cost to unlock contact
  maxUnlocks    Int      @default(3)   // shared/non-exclusive, like TripClap

  unlocks       LeadUnlock[]
  notes         LeadNote[]
  activities    LeadActivity[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([destinationId])
  @@index([cityId])
  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  authorId  String
  author    AdminUser @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String   // CREATED, VERIFIED, UNLOCKED, STATUS_CHANGE, ...
  actor     String   // "System", an agent's company name, or an admin's name
  detail    String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ---------- Agent side ----------

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CompanyType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

model Agent {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String

  companyName     String
  contactName     String
  phone           String

  servicesWanted  String   // JSON-stringified array, e.g. ["TRAVEL_LEADS","TRAVEL_CRM"]
  dailyLeadTarget Int      @default(10)

  officeAddress   String?
  officeCity      String?
  officeState     String?
  gstNumber       String?
  companySince    Int?
  teamSize        Int?
  companyType     CompanyType?
  facebookUrl     String?
  instagramUrl    String?

  status          AgentStatus @default(PENDING)
  credits         Int      @default(0)

  assignedRmId    String?
  assignedRm      AdminUser? @relation(fields: [assignedRmId], references: [id])

  destinations    AgentDestination[]
  packages        Package[]
  unlocks         LeadUnlock[]
  transactions    CreditTransaction[]
  notes           AgentNote[]
  activities      AgentActivity[]
  proposals       Proposal[]
  paymentOrders   PaymentOrder[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assignedRmId])
}

model AgentNote {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  authorId  String
  author    AdminUser @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([agentId])
}

model AgentActivity {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  type      String   // REGISTRATION, TALKED, INFO, LOGIN, STATUS_CHANGE, ...
  actor     String   // "System" or an admin's name
  detail    String
  createdAt DateTime @default(now())

  @@index([agentId])
}

model AgentDestination {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@unique([agentId, destinationId])
  @@index([destinationId])
}

model LeadUnlock {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  creditsSpent  Int
  unlockedAt    DateTime @default(now())

  @@unique([agentId, leadId])
  @@index([leadId])
}

enum CreditTxnType {
  TOPUP
  UNLOCK_SPEND
  BONUS
  REFUND
}

model CreditTransaction {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  amount    Int      // positive = credit added, negative = spent
  type      CreditTxnType
  note      String?
  createdAt DateTime @default(now())

  @@index([agentId])
}

model CreditPack {
  id            String   @id @default(cuid())
  name          String
  tagline       String?
  amountINR     Int
  baseCredits   Int
  bonusCredits  Int      @default(0)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)

  paymentOrders PaymentOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

model PaymentOrder {
  id               String   @id @default(cuid())
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id])

  razorpayOrderId  String   @unique
  razorpayPaymentId String?

  packId           String
  pack             CreditPack @relation(fields: [packId], references: [id])
  amountINR        Int      // paise amount charged
  creditsToApply   Int      // credits to grant once paid (base + bonus)

  status           PaymentOrderStatus @default(CREATED)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agentId])
  @@index([packId])
}

// ---------- Admin ----------

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
}

model Proposal {
  id              String   @id @default(cuid())
  proposalNumber  String   @unique

  agentId         String?
  agent           Agent?   @relation(fields: [agentId], references: [id])
  prospectName    String
  prospectCompany String?
  prospectEmail   String?
  prospectPhone   String?

  preparedById    String
  preparedBy      AdminUser @relation(fields: [preparedById], references: [id])

  planName        String
  planTagline     String?
  walletCredits   Int
  validityMonths  Int
  domesticLeadPrice    Int
  internationalLeadPrice Int
  features        String   // JSON-stringified array of bullet strings

  subtotal        Int
  gstPercent      Int      @default(18)
  totalPayable    Int

  paymentInstructions String?
  kycChecklist    String   // JSON-stringified array of bullet strings
  termsText       String
  reversalPolicyText String
  refundPolicyText   String

  status          ProposalStatus @default(DRAFT)
  validTill       DateTime

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId])
  @@index([preparedById])
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String

  managedAgents  Agent[]
  agentNotes     AgentNote[]
  leadNotes      LeadNote[]
  proposals      Proposal[]

  createdAt      DateTime @default(now())
}

// Every site image, stored once as WebP and served from /media/{slug}.webp on
// our own domain (no hotlinking, stable URLs for image search and schema).
model MediaAsset {
  id        String   @id @default(cuid())
  slug      String   @unique
  mime      String   @default("image/webp")
  width     Int
  height    Int
  bytes     Bytes
  alt       String
  sourceUrl String   @default("")
  credit    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
