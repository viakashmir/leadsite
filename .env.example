# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres connection string (e.g. Supabase "Transaction" pooler URI).
# Falls back to a local SQLite file if unset in dev.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Secret used to sign agent/admin session cookies. Generate a real random value in production.
JWT_SECRET="change-me"

# Razorpay (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Razorpay (Dashboard -> Settings -> Webhooks) — used to verify webhook payloads
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Same value as RAZORPAY_KEY_ID, exposed to the browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Public site URL, used for canonical links, sitemap, and OG tags
SITE_URL="http://localhost:3000"

# Pixabay (https://pixabay.com/service/about/api/) — used by the admin panel's
# "Fetch photo from Pixabay" / "Backfill all photos" actions to auto-fill
# destination and package hero images. Optional — those buttons show a clear
# error if unset.
PIXABAY_API_KEY=""

# ViaItinerary CRM's public inquiry intake — new leads are mirrored here in the
# background after each submission (best-effort, never blocks/fails the
# visitor's enquiry). Optional — defaults to the production CRM below.
VIAITINERARY_INQUIRY_URL="https://crm.viakashmir.in/api/public-inquiries"
