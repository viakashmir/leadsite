# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres connection string (e.g. Supabase "Transaction" pooler URI).
# Falls back to a local SQLite file if unset in dev.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Secret used to sign agent/admin session cookies. Generate a real random value in production.
JWT_SECRET="change-me"

# "Continue with Google" on /login (optional). Redirect URI to register:
#   {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated emails that sign in as Admin with Google.
ADMIN_EMAILS=""

# Razorpay (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Razorpay (Dashboard -> Settings -> Webhooks) — used to verify webhook payloads
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Same value as RAZORPAY_KEY_ID, exposed to the browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Public site URL, used for canonical links, sitemap, and OG tags
SITE_URL="http://localhost:3000"

# Pixabay (https://pixabay.com/service/about/api/) — used by the admin panel's
# "Fetch photo from Pixabay" / "Backfill all photos" actions to auto-fill
# destination and package hero images. Optional — those buttons show a clear
# error if unset.
PIXABAY_API_KEY=""

# Pexels (https://www.pexels.com/api/): fallback photo source when Pixabay has
# no match. Photos are downloaded and stored as WebP, never hotlinked.
PEXELS_API_KEY=""

# Local dev against a single-connection Postgres (e.g. PGlite): set to 1.
# PG_POOL_MAX=1

# Search engine ownership tags (meta verification). Optional; add after
# creating each account: Google Search Console, Bing Webmaster Tools, Yandex.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""

# Resend (https://resend.com/api-keys): lead notification emails. On every new
# lead the admin gets an alert and the customer gets a "thanks for contacting
# us" email. Without a key, leads still save; the emails are skipped and the
# failure is noted on the lead's timeline.
RESEND_API_KEY=""
# Sender. Must be on a domain verified in Resend (Domains -> Add domain), e.g.
# "Tavel Package <hello@tavelpackage.in>". The default onboarding@resend.dev
# can only deliver to the Resend account owner's own address.
EMAIL_FROM=""
# Who receives new-lead alerts, comma-separated
# (defaults to arfatshah.qa@gmail.com,aribanigar034@gmail.com).
ADMIN_NOTIFY_EMAIL=""
# Where customers' replies to their thank-you email go (defaults to aribanigar034@gmail.com).
CUSTOMER_REPLY_TO=""
